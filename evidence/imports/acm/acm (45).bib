@proceedings{10.1145/3793654,
editor = {Breno Miranda, Ana Paiva, Markus Borg, Andy Zaidman and Morena Barboni},
title = {AST '26: Proceedings of the 7th ACM/IEEE International Conference on Automation of Software Test},
year = {2026},
isbn = {9798400724763},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {The special theme of AST 2026 is "Adapting test automation to the AI era including sustainability and emerging challenges". We are seeing that the AI era is causing a transformative shift in test automation, revolutionizing traditional approaches and enhancing efficiency, accuracy, and adaptability. This integration of AI and machine learning introduces intelligent test case generation, self-healing test scripts, and predictive analytics. These advances have the potential to significantly reduce testing time, while improving overall software quality. The role of testers will evolve from test script writers to strategic overseers, focusing on test design, data and quality interpretation, and critical problem-solving. As AI takes on repetitive tasks, it allows for more comprehensive test coverage, including the identification of edge cases that human testers might overlook. The future of test automation lies in agent-like testing systems that learn continuously, adapt to changes, and provide deeper insights into software quality, ultimately leading to faster, more reliable software delivery in an increasingly complex digital landscape.},
location = {Rio de Janeiro, Brazil}
}

