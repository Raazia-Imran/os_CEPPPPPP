@proceedings{10.1145/3757348,
editor = {Ashley Barker, Bilel Hadri, Colleen Bertoni, Nick Hagerty and Timothy W. Robinson},
title = {CUG '25: Proceedings of the Cray User Group},
year = {2025},
isbn = {9798400713279},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {The Cray User Group (CUG) is an independent, international organization composed of member institutions that own or operate Cray—and now select HPE Apollo—high-performance computing (HPC) systems. Since its founding in 1978, CUG has served as a vital forum for collaboration, technical exchange, and community building within the global HPE/Cray HPC ecosystem.Each year, CUG hosts a flagship technical conference, welcoming submissions of full papers, presentations, tutorials and Birds-of-a-Feather (BoF) sessions in the following categories:This year we received 61 full paper submissions, and each was rigorously peer-reviewed by between three and five reviewers drawn from a large pool of program committee members. The 18 most highly rated full papers were selected for inclusion in the present proceedings.The theme for the 2025 event is Computing Horizons. With this theme, we want to capture the sense of the great opportunities arrayed in front of us, with the tight integration of traditional HPC workloads and powerful AI enabled by innovations in algorithms and special purpose hardware. The 2025 conference is about this bright future and the exploration of these limitless possibilities and their associated challenges.},
location = {Jersey City, USA}
}

