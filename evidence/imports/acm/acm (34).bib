@inbook{10.1145/3837873.3838076,
author = {Hou, Yongpeng},
title = {Neural Network-Driven Computational Framework for Personalized Learning and Compe-tency Assessment in Innovation and Entrepreneurship Education},
year = {2026},
isbn = {9798400722660},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3837873.3838076},
abstract = {Traditional innovation and entrepreneurship education often suffers from homogeneous learning supply, subjective competency evaluation, weak process mining, and insufficient algorithmic feedback. To address these limitations, this paper constructs a neural network-driven computational framework that integrates learner-event modeling, educational data mining, adaptive recommendation, and multi-task competency assessment. The proposed method encodes learning behavior, knowledge mastery, project evidence, collaboration signals, and governance metadata into a unified feature vector, and then uses an embedding layer, feed-forward hidden representation, attention-based fusion, and dual output heads to generate both personalized learning recommendations and competency assessment scores. Compared with a rule-based teaching baseline, the simulation results show 92.3\% resource matching accuracy, a 31.7\% improvement in competency-fit consistency, and a 65\% increase in feedback efficiency. The study provides a reproducible artificial-intelligence route for computational education systems and offers an implementable model for individualized innovation-and-entrepreneurship talent cultivation.},
booktitle = {Proceedings of the 2026 3rd Guangdong-Hong Kong-Macao Greater Bay Area International Conference on Digital Economy and Artificial Intelligence},
pages = {1354–1362},
numpages = {9}
}

