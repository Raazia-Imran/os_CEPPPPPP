@inproceedings{10.1145/3625468.3647627,
author = {Rahmanian, Ali and Amin, Siddharth and Gustafsson, Harald and Ali-Eldin, Ahmed},
title = {CVF: Cross-Video Filtration on the Edge},
year = {2024},
isbn = {9798400704123},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3625468.3647627},
doi = {10.1145/3625468.3647627},
abstract = {Many edge applications rely on expensive Deep-Neural-Network (DNN) inference-based video analytics. Typically, a single instance of an inference service analyzes multiple realtime camera streams concurrently. In many cases, only a fraction of these streams contain objects-of-interest at a given time. Hence, it is a waste of computational resources to process all frames from all cameras using the DNNs. On-camera filtration of frames has been suggested as a possible solution to improve the system efficiency and reduce resource wastage. However, many cameras do not have on-camera processing or filtering capabilities. In addition, filtration can be enhanced if frames across the different feeds are selected and prioritized for processing based on the system load and the available resource capacity. This paper introduces CVF, a Cross-video Filtration framework designed around video content and resource constraints. The CVF pipeline leverages compressed-domain data from encoded video formats, lightweight binary classification models, and an efficient prioritization algorithm. This enables the effective filtering of cross-camera frames from multiple sources, processing only a fraction of frames using resource-intensive DNN models. Our experiments show that CVF is capable of reducing the overall response time of video analytics pipelines by up to 50\% compared to state-of-the-art solutions while increasing the throughput by up to 120\%.},
booktitle = {Proceedings of the 15th ACM Multimedia Systems Conference},
pages = {231–242},
numpages = {12},
keywords = {Codecs, Edge, Video Analytics, Video Filtration},
location = {Bari, Italy},
series = {MMSys '24}
}

@inproceedings{10.1145/3813822.3814061,
author = {Yu, Zunpeng and Du, Dongdong and Chen, Yuwei and Wen, Bin},
title = {Research on Key Technologies and Application Platform Frameworks for Intelligent Steelmaking},
year = {2026},
isbn = {9798400722578},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3813822.3814061},
doi = {10.1145/3813822.3814061},
abstract = {The steel industry plays a vital role in supporting and driving national economic development. However, steel production faces challenges such as complex processes and bottlenecks to improving efficiency; intelligent transformation is the core pathway to achieving high-end, green development. Based on the national “AI+” strategic orientation, this paper summarizes and constructs a key technological framework to support the intelligent transformation of the steel metallurgy industry. We focused on analyzing intelligent technologies, including artificial intelligence and the Industrial Internet of Things (IIoT). In this paper, we established a technology system centered on data, with seamless integration of sensing, networking, computing, and intelligence technologies that covers the entire process of data collection, transmission, processing, analysis, decision-making, and execution. An intelligent steelmaking platform integrating artificial intelligence and the Industrial Internet of Things (IIoT) has been developed, forming an integrated application framework comprising edge sensing, platform hub, and intelligent applications. The research findings presented in this paper can provide technical references and practical guidance for the intelligent upgrading of steel enterprises, helping the industry undergo a profound transformation from experience-driven to data- and model-driven operations.},
booktitle = {Proceedings of the 2026 7th International Conference on Computer Information and Big Data Applications},
pages = {1472–1479},
numpages = {8},
keywords = {Artificial Intelligence, Industrial Internet, Smart Manufacturing, Steel Industry},
location = {Wuhan, China},
series = {CIBDA '26}
}

