@inproceedings{10.1145/3711129.3711189,
author = {Gu, Lin and Liu, Chenhao and Chen, Xiao},
title = {A DL-Mesh and dual check based multi-core chiplet communication mechanism},
year = {2025},
isbn = {9798400710094},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3711129.3711189},
doi = {10.1145/3711129.3711189},
abstract = {As transistors continue to shrink, chip designs become increasingly complex and densely packed, presenting a challenge in balancing performance and cost. That motivates designers to divide SoC into many small specialized chips (chiplets) with maximum performance benefits but lower complexity and cost. We focus on communication algorithm of chiplets and propose a dual layer Mesh topology and an adaptive congestion fault-tolerant routing algorithm, which achieve a greater throughput than mesh topology. Besides, we propose two dual check mechanism for soft error in communication, it can detect single bit and double bits errors 100\%. The 2*2 and 3*3 multi-core architectures (based on our topology and check mechanism) only decreases performance by about 7\% -11\%, and 35\% -48\% under single and double node failures.},
booktitle = {Proceedings of the 2024 8th International Conference on Electronic Information Technology and Computer Engineering},
pages = {345–352},
numpages = {8},
keywords = {Chiplet, Double check, NoC, Routing algorithm},
location = {Haikou, Guangdong, China},
series = {EITCE '24}
}

