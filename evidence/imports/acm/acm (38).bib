@article{10.1145/3830473,
author = {Ni, Xiaobing and Ge, Mengke and Ruan, Jiaheng and Jin, Tongyu and Lu, Haoyu and Kang, Yi and Chen, Song},
title = {SparseMap: A Sparse CNN Mapping Framework Tailored for Streaming Coarse-grained Reconfigurable Array},
year = {2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
issn = {1084-4309},
url = {https://doi.org/10.1145/3830473},
doi = {10.1145/3830473},
abstract = {Streaming coarse-grained reconfigurable array (CGRA), with its reconfigurability and efficient memory access, is a promising platform for the convolutional neural network (CNN) inference. While model sparsity is widely used to accelerate scaling CNNs, existing methods lack support for mapping sparse CNNs onto streaming CGRAs, mainly due to the substantial configuration overhead and complex I/O data scheduling at the processing element array (PEA) side. To bridge this gap, we propose SparseMap, the first mapping framework for sparse CNN processing on streaming CGRA. Firstly, SparseMap introduces an inter-operator configuration context sharing mechanism to reduce configuration overhead, along with a Multi-graph Maximum Common Subgraph (Multi-MCS)-based optimization method, which jointly fine-tunes sparsity patterns across operators to maximize the sharing benefits. Secondly, to handle the irregularity of sparse processing, SparseMap establishes a co-optimization approach that integrates PEA-side I/O data planning with operation scheduling&amp;binding, coordinating I/O data and computation to ensure high-throughput operator mapping. In addition, SparseMap introduces a hierarchical mapping strategy to improve mapping efficiency. Experiments show that SparseMap effectively enables sparse CNN processing on streaming CGRAs. Compared to baseline methods, SparseMap reduces the configuration overhead by one to three orders of magnitude, effectively alleviating the configuration pressure, while achieving a speedup of 1.24 {\texttimes} to 2.49 {\texttimes} over dense computation.},
note = {Just Accepted},
journal = {ACM Trans. Des. Autom. Electron. Syst.},
month = jul,
keywords = {Streaming CGRA, sparse CNN processing, configuration overhead, context sharing, I/O data planning.}
}

@inproceedings{10.1145/3462462.3468880,
author = {Liu, Rui and Krishnan, Sanjay and Elmore, Aaron J. and Franklin, Michael J.},
title = {Understanding and optimizing packed neural network training for hyper-parameter tuning},
year = {2021},
isbn = {9781450384865},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3462462.3468880},
doi = {10.1145/3462462.3468880},
abstract = {As neural networks are increasingly employed in machine learning practice, how to efficiently share limited training resources among a diverse set of model training tasks becomes a crucial issue. To achieve better utilization of the shared resources, we explore the idea of jointly training multiple neural network models on a single GPU in this paper. We realize this idea by proposing a primitive, called pack. We further present a comprehensive empirical study of pack and end-to-end experiments that suggest significant improvements for hyperparameter tuning. The results suggest: (1) packing two models can bring up to 40\% performance improvement over unpacked setups for a single training step and the improvement increases when packing more models; (2) the benefit of the pack primitive largely depends on a number of factors including memory capacity, chip architecture, neural network structure, and batch size; (3) there exists a trade-off between packing and unpacking when training multiple neural network models on limited resources; (4) a pack-aware Hyperband is up to 2.7X faster than the original Hyperband, with this improvement growing as memory size increases and subsequently the density of models packed.},
booktitle = {Proceedings of the Fifth Workshop on Data Management for End-To-End Machine Learning},
articleno = {3},
numpages = {11},
location = {Virtual Event, China},
series = {DEEM '21}
}

@article{10.1145/3785362,
author = {Liu, Miao and Ni, Liwei and Liu, Junfeng and Meng, Xingyu and Wang, Rui and Lin, Xiaoze and Lai, Xinhua and Li, Xingquan and Xu, Jungang},
title = {A Survey of Machine Learning Approaches in Logic Synthesis},
year = {2026},
issue_date = {March 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {31},
number = {2},
issn = {1084-4309},
url = {https://doi.org/10.1145/3785362},
doi = {10.1145/3785362},
abstract = {The increasing complexity of digital circuits and the limitations of heuristic methods have led to growing interest in applying Machine Learning (ML) to Logic Synthesis (LS). ML provides a promising paradigm shift by implementing automated, scalable, and data-driven optimization strategies. This survey provides a comprehensive overview of the latest studies on ML approaches in LS, offering a deep understanding of the fundamental ML methods, and analyzing their strengths and limitations through systematic comparisons. We categorize existing works into two main types: ML-Assistance methods aiming at predicting performance metrics and reducing the cost of traditional simulations, and ML-Agent methods directly replacing heuristic processes in the LS flow. We further analyze ML methods and applications in different LS stages, including Boolean circuit generation, Boolean circuit analysis, logic optimization, and technology mapping, showing great achievements and improvement in exploring non-linear design spaces and discovering new optimization strategies. Finally, we discuss the challenges and limitations in the current situation and further provide a vision of future directions in LS.},
journal = {ACM Trans. Des. Autom. Electron. Syst.},
month = jan,
articleno = {38},
numpages = {43},
keywords = {Machine learning, logic synthesis, electronic design automation, logic optimization}
}

