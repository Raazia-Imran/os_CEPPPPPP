@inbook{10.1145/3774748.3795671,
author = {Yao, Simeng and Zhao, Jialin and Zhang, Yang and Wu, Yiwen and Wang, Tao and Zhang, Xunhui},
title = {Understanding the Executability of Example Code in Hugging Face Model Cards: An Empirical Study},
year = {2026},
isbn = {9798400722967},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3774748.3795671},
abstract = {Example code in Hugging Face model cards serves as an important entry point for users to understand and adopt pretrained models; however, during execution, users frequently encounter execution errors, which in turn undermines reproducibility and practical usability. Given the long-standing lack of systematic evaluation of this phenomenon, we conduct a large-scale empirical study on the executability of model-card example code. Our results show that, among 291 model cards, 65.98\% of example code fails to execute, indicating substantial limitations in real-world usability. Further analysis reveals that failure rates increase with model size and vary significantly across task types, with speech, vision, multimodal, and generative tasks being particularly fragile. Based on execution logs, we identify three dominant root causes: insufficient documentation of dependencies and version requirements, implicit runtime environment assumptions embedded in example code, and incompatibilities induced by ecosystem evolution (e.g., API changes). This study provides preliminary empirical evidence for assessing the effectiveness of model-card examples in real-world usage scenarios.},
booktitle = {Proceedings of the 2026 IEEE/ACM 48th International Conference on Software Engineering},
pages = {443–445},
numpages = {3}
}

