@inproceedings{10.1145/3700906.3700954,
author = {Lai, Zhihao and Zhao, Qingbei},
title = {VRA-L: A real-time system for generating expressive avatar animations and object detection based on RGB cameras and monocular videos},
year = {2024},
isbn = {9798400707032},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3700906.3700954},
doi = {10.1145/3700906.3700954},
abstract = {To achieve low-cost, markerless motion capture, the system uses MediaPipe for pose estimation and Kalidokit for real-time 3D character animation. It employs a key-value pair mapping technique for versatile skeleton control and camera simulation for user interaction. The system integrates Graph Convolutional Networks (GCN) for feature learning and Long Short-Term Memory (LSTM) networks for processing temporal sequences. By extracting key skeletal points from hands, face, and pose, and combining them with GCN and LSTM, it accurately captures human poses. On an RTX 4070 device, it showed a 30\% reduction in acceleration error and a 65\% reduction in network parameters and computational load, achieving 55-60 frames per second for 3-Dimension pose estimation. Spherical linear interpolation is applied to enhance motion smoothness, providing a good user experience with real-time action recognition and display.},
booktitle = {Proceedings of the International Conference on Image Processing, Machine Learning and Pattern Recognition},
pages = {292–298},
numpages = {7},
keywords = {Camera driver, Human pose estimation, Metaverse, Motion capture, Neural network, Virtual characters},
location = {Guangzhou, China},
series = {IPMLP '24}
}

