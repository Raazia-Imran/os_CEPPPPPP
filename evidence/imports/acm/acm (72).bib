@inproceedings{10.1145/3565010.3569065,
author = {Tootaghaj, Diman Zad and Mercian, Anu and Adarsh, Vivek and Sharifian, Mehrnaz and Sharma, Puneet},
title = {SmartNICs at edge for transient compute elasticity},
year = {2022},
isbn = {9781450399227},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3565010.3569065},
doi = {10.1145/3565010.3569065},
abstract = {This paper proposes a new architecture that strategically harvests the untapped compute capacity of the SmartNICs to offload transient microservices workload spikes, thereby reducing the SLA violations while providing better performance/energy consumption. This is particularly important for ML workloads at Edge deployments with stringent SLA requirements. Usage of the untapped compute capacity is more favorable than deploying extra servers, as SmartNICs are economically and operationally more desirable. We propose Spike-Offload, a low-cost and scalable platform that leverages machine learning to predict the spikes and orchestrates seamless offloading of generic microservices workloads to the SmartNICs, eliminating the need for pre-deploying expensive host servers and their under-utilization. Our SpikeOffload evaluation shows that SLA violations can be reduced by up to 20\% for specific workloads. Furthermore, we demonstrate that for specific workloads our approach can potentially reduce capital expenditure (CAPEX) by more than 40\%. Also, performance per unit energy consumption can be improved by upto 2X.},
booktitle = {Proceedings of the 3rd International Workshop on Distributed Machine Learning},
pages = {9–15},
numpages = {7},
keywords = {SmartNIC, application offload, edge, serverless computing},
location = {Rome, Italy},
series = {DistributedML '22}
}

@proceedings{10.1145/3725789,
title = {CUG '24: Proceedings of the Cray User Group},
year = {2024},
isbn = {9798400713286},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {The Cray User Group (CUG) is an independent, international organization composed of member institutions that own or operate Cray—and now select HPE Apollo—high-performance computing (HPC) systems. Since its founding in 1978, CUG has served as a vital forum for collaboration, technical exchange, and community building within the global HPE/Cray HPC ecosystem.  Each year, CUG hosts a flagship technical conference, welcoming submissions of full papers, presentations, tutorials and Birds-of-a-Feather (BoF) sessions in the following categories:— Applications, Analytics and Environments—Systems Support—User Services—File Systems and I/OThis year we received 49 full paper submissions, and each was rigorously peer-reviewed by between three and five reviewers drawn from a large pool of program committee members. The eight most highly rated full papers were selected for inclusion in the present proceedings.The theme of CUG 2024, Diverse Universe, reflected the community's dedication to supporting a wide range of scientific workloads and services—most notably, world—class radio astronomy. The theme also celebrated Australia's rich biodiversity, symbolized by the quokka featured in the event's logo, and underscored CUG's ongoing commitment to diversity and inclusivity in the HPC field.},
location = {Perth, Australia}
}

