@inproceedings{10.1145/3736426.3736455,
author = {Hou, Jiewen and Bai, Zhiqiang and Li, Yongle and Yuan, Ye},
title = {Intelligent Scheduling Enhancement Technology for Optimizing Tobacco Production Supply Chain Based on AI},
year = {2025},
isbn = {9798400714238},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3736426.3736455},
doi = {10.1145/3736426.3736455},
abstract = {In order to improve the scheduling optimization capability of the tobacco production supply chain, a data-driven intelligent scheduling approach is adopted to construct an optimization model, and dynamic scheduling optimization is carried out based on deep reinforcement learning and genetic algorithm. The study analyzes the performance of the scheduling system on indicators such as order fulfillment rate, inventory turnover, transportation cost and production energy consumption. The results show that the method can improve supply chain operation efficiency, reduce resource consumption, optimize logistics scheduling, and provide scientific and effective scheduling strategies for supply chain management in the tobacco industry.},
booktitle = {Proceedings of the 2025 International Conference on Digital Management and Information Technology},
pages = {172–178},
numpages = {7},
keywords = {artificial intelligence (AI), intelligent scheduling, scheduling algorithm, supply chain optimization, tobacco production supply chain},
location = {Shenyang, China},
series = {DMIT '25}
}

