@inbook{10.1145/3832928.3832984,
author = {Wang, Shaohua and Zhang, Tingyu and Lu, Hui and Tang, Xuan},
title = {Graph-Memory Large-Scale Model-Driven Cross-Enterprise Multi-Objective Supplier Portfolio Optimization for Shared Supply Chains},
year = {2026},
isbn = {9798400723339},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3832928.3832984},
abstract = {With the rise of new collaborative modes such as co-design, capacity pooling and shared warehousing, enterprises must optimize multiple, tightly coupled objectives. To overcome the limitations of existing methods in simultaneously handling heterogeneous text–based risk identification and multi-objective trade-offs at the portfolio level, this paper proposes a cross-enterprise, multi-objective supplier combinatorial optimization framework that integrates graph memory with a large language model. First, we build a unified index covering six data domains-financial reports, public sentiment, contract emails, BOMs, etc.-and construct a supplier-sharing-event-risk-indicator knowledge graph in a graph database. Second, we design a graph-memory LLM that applies clause gating and shared-semantic attention reasoning over the multi-layer event graph, outputs real-time r-dimensional risk vectors, and calibrates them via a sensitivity-driven mechanism. Third, we develop a genetic-differential hybrid search with gated memory to obtain Pareto-optimal supplier portfolios under budget, lead-time and sharing-ratio constraints, enabling strategy self-evolution. Finally, we generate cost–lead time–sharing–residual risk summaries through cross-domain semantic alignment to provide managers with interpretable decision support. An 18-month case study using data from 278 suppliers of a leading electronics manufacturer shows that, compared to conventional GA and BERT-KG approaches, our method reduces total cost, average lead time and risk exposure by 6.3\%, 8.7\% and 15.4\%, respectively.},
booktitle = {Proceedings of the 2026 3rd International Conference on Machine Learning, Natural Language Processing and Modeling},
pages = {357–363},
numpages = {7}
}

@inproceedings{10.1145/3603287.3651205,
author = {Dhar, Nobel and Deng, Bobin and Lo, Dan and Wu, Xiaofeng and Zhao, Liang and Suo, Kun},
title = {An Empirical Analysis and Resource Footprint Study of Deploying Large Language Models on Edge Devices},
year = {2024},
isbn = {9798400702372},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3603287.3651205},
doi = {10.1145/3603287.3651205},
abstract = {The success of ChatGPT is reshaping the landscape of the entire IT industry. The large language model (LLM) powering ChatGPT is experiencing rapid development, marked by enhanced features, improved accuracy, and reduced latency. Due to the execution overhead of LLMs, prevailing commercial LLM products typically manage user queries on remote servers. However, the escalating volume of user queries and the growing complexity of LLMs have led to servers becoming bottlenecks, compromising the quality of service (QoS). To address this challenge, a potential solution is to shift LLM inference services to edge devices, a strategy currently being explored by industry leaders such as Apple, Google, Qualcomm, Samsung, and others. Beyond alleviating the computational strain on servers and enhancing system scalability, deploying LLMs at the edge offers additional advantages. These include real-time responses even in the absence of network connectivity and improved privacy protection for customized or personal LLMs.This article delves into the challenges and potential bottlenecks currently hindering the effective deployment of LLMs on edge devices. Through deploying the LLaMa-2 7B model with INT4 quantization on diverse edge devices and systematically analyzing experimental results, we identify insufficient memory and/or computing resources on traditional edge devices as the primary obstacles. Based on our observation and empirical analysis, we further provide insights and design guidance for the next generation of edge devices and systems from both hardware and software directions.},
booktitle = {Proceedings of the 2024 ACM Southeast Conference},
pages = {69–76},
numpages = {8},
keywords = {Edge Computing, Edge Devices, LLaMA-2, Large Language Models (LLMs)},
location = {Marietta, GA, USA},
series = {ACMSE '24}
}

