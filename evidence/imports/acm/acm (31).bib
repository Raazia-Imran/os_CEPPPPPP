@inproceedings{10.1145/3785706.3785986,
author = {Gong, Shunqiang and Xing, Wenwen},
title = {Identifying the Structural Characteristics of the Transnational Mobility Network of Highly Skilled Talent Based on Social Network Analysis and Machine Learning},
year = {2026},
isbn = {9798400719516},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3785706.3785986},
doi = {10.1145/3785706.3785986},
abstract = {In the context of globalization, identifying the structural characteristics of the complex networks formed by the transnational mobility of highly skilled talent is a key support for optimizing global talent allocation and enhancing national industrial competitiveness. Traditional social network analysis (SNA) focuses solely on static topological features, ignoring attributes such as talent skill level and industry demand fit, as well as temporal dynamics. Single machine learning (ML) methods (such as standard GAT) isolate network structural relevance, resulting in insufficient comprehensiveness and timeliness in feature identification. To address this issue, a dynamic multi-attribute fusion-based high-skilled talent mobility network feature identification algorithm (DMF-NFR) is proposed. This algorithm utilizes dynamic network construction (dividing the time slices into 36 quarterly time slices, corresponding to 2015Q1 to 2023Q4 (9 years)), multi-attribute attention fusion (balancing skill-industry fit and mobility stability), and an improved GNN collaborative learning approach (synchronizing topological and attribute features) to overcome the bottleneck of information fragmentation in the three-dimensional ``structure-attribute-time" domain. Experiments based on the 2015-2023 OECD database (30 countries, 1.2 million records) show that the DMF-NFR feature recognition accuracy reached 92.3\% (13.7\% higher than traditional SNA and 8.7\% higher than standard GAT), a key node recall rate of 89.5\% (11.2\% higher than traditional SNA), and a dynamic capture latency of 0.3 seconds (75\% lower than traditional SNA). This algorithm theoretically improves the dynamic multi-attribute identification method system for complex networks. In practice, it can provide quantitative tools for countries to accurately identify talent mobility shortcomings, optimize talent recruitment policies, and facilitate regional talent cooperation decision-making.},
booktitle = {Proceedings of the 2025 2nd International Conference on Digital Economy and Computer Science},
pages = {1779–1785},
numpages = {7},
keywords = {Cross-border mobility of highly skilled talent, dynamic multi-attribute fusion algorithm (DMF-NFR), graph neural network (GNN), machine learning (ML), network feature recognition, social network analysis (SNA)},
location = {Wuhan, China},
series = {DECS '25}
}

@inproceedings{10.1145/3774934.3786451,
author = {Roca, Aleix and Beltran, Vicen{\c c}},
title = {Rethinking Thread Scheduling under Oversubscription: A User-Space Framework for Coordinating Multi-runtime and Multi-process Workloads},
year = {2026},
isbn = {9798400723100},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3774934.3786451},
doi = {10.1145/3774934.3786451},
abstract = {The convergence of high-performance computing (HPC) and artificial intelligence (AI) is driving the emergence of increasingly complex parallel applications and workloads. These workloads often combine multiple parallel runtimes within the same application or across co-located jobs, creating scheduling demands that place significant stress on traditional OS schedulers. When oversubscribed (there are more ready threads than cores), OS schedulers rely on periodic preemptions to multiplex cores, often introducing interference that may degrade performance. In this paper, we present: (1) The User-space Scheduling Framework (USF), a novel seamless process scheduling framework completely implemented in user-space. USF enables users to implement their own process scheduling algorithms without requiring special permissions. We evaluate USF with its default cooperative policy, (2) SCHED_COOP, designed to reduce interference by switching threads only upon blocking. This approach mitigates well-known issues such as Lock-Holder Preemption (LHP), Lock-Waiter Preemption (LWP), and scalability collapse. We implement USF and SCHED_COOP by extending the GNU C library with the nOS-V runtime, enabling seamless coordination across multiple runtimes (e.g., OpenMP) without requiring invasive application changes. Evaluations show gains up to 2.4x in oversubscribed multi-process scenarios, including nested BLAS workloads, multi-process PyTorch inference with LLaMA-3, and Molecular Dynamics (MD) simulations.},
booktitle = {Proceedings of the 31st ACM SIGPLAN Annual Symposium on Principles and Practice of Parallel Programming},
pages = {53–67},
numpages = {15},
keywords = {High Performance Computing, Runtime Systems, Thread Oversubscription, User-Space Scheduling},
location = {Sydney, NSW, Australia},
series = {PPoPP '26}
}

@article{10.14778/3510397.3510402,
author = {Shin, Ahnjae and Jeong, Joo Seong and Kim, Do Yoon and Jung, Soyoung and Chun, Byung-Gon},
title = {Hippo: sharing computations in hyper-parameter optimization},
year = {2022},
issue_date = {January 2022},
publisher = {VLDB Endowment},
volume = {15},
number = {5},
issn = {2150-8097},
url = {https://doi.org/10.14778/3510397.3510402},
doi = {10.14778/3510397.3510402},
abstract = {Hyper-parameter optimization is crucial for pushing the accuracy of a deep learning model to its limits. However, a hyper-parameter optimization job, referred to as a study, involves numerous trials of training a model using different training knobs, and therefore is very computation-heavy, typically taking hours and days to finish.We observe that trials issued from hyper-parameter optimization algorithms often share common hyper-parameter sequence prefixes. Based on this observation, we propose Hippo, a hyper-parameter optimization system that reuses computation across trials to reduce the overall amount of computation significantly. Instead of treating each trial independently as in existing hyper-parameter optimization systems, Hippo breaks down the hyper-parameter sequences into stages and merges common stages to form a tree of stages (a stage tree). Hippo maintains an internal data structure, search plan, to manage the current status and history of a study, and employs a critical path based scheduler to minimize the overall study completion time. Hippo applies to not only single studies but multi-study scenarios as well. Evaluations show that Hippo's stage-based execution strategy outperforms trial-based methods for several models and hyper-parameter optimization algorithms, reducing end-to-end training time by up to 2.76X (3.53x) and GPU-hours by up to 4.81X (6.77x), for single (multiple) studies.},
journal = {Proc. VLDB Endow.},
month = jan,
pages = {1038–1052},
numpages = {15}
}

