@inproceedings{10.1145/3801487.3801807,
author = {Pei, Xiaokun and Jiang, Zhuolun and Chen, Mingyu and Wang, Songyue and Lu, Tianyue},
title = {AExec: Asynchronous Multi-accelerator Execution and Management Mechanism},
year = {2026},
isbn = {9798400725685},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3801487.3801807},
doi = {10.1145/3801487.3801807},
abstract = {With the growing hardware specialization of warehouse-scale computers (WSCs) driven by cloud computing, integrating multiple accelerators near CPU cores has become critical to optimizing the “datacenter tax.” However, the increasing variety and number of accelerators have exposed existing synchronous driving mechanisms such as RoCC to control inefficiency, memory resource contention, and poor scalability, which limit the concurrent performance of multi-accelerator systems. To address these issues, we propose a hardware-software co-designed asynchronous multi-accelerator execution and management mechanism (AExec). It enables the CPU to drive multiple accelerator tasks concurrently and to sense task completion in a lightweight and efficient manner. AExec also collaborates with an asynchronous memory access unit (AMU) that prefetches accelerator-required data into scratchpad memory (SPM), avoiding cache contention with the CPU. We implement AExec at the RTL level as xAExec on the XiangShan processor. Experimental evaluation on an AMD Xilinx Virtex UltraScale+ VCU128 FPGA shows that in an 8‑accelerator configuration, xAExec reduces execution time by 9.3\%-12.1\% compared to RoCC, while introducing only 2.9\% additional LUT overhead. When combined with AMU, xAExec further reduces average execution time by 16\%, confirming the effectiveness of the proposed asynchronous control and memory access optimization.},
booktitle = {Proceedings of the 23rd ACM International Conference on Computing Frontiers},
pages = {179–187},
numpages = {9},
keywords = {Asynchronous acceleration, Memory access optimization, Multi-accelerator, Heterogeneous computing},
location = {Catania, Italy},
series = {CF '26}
}

