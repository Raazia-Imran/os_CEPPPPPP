@inproceedings{10.1145/3788853.3803078,
author = {Fang, Peng and Guo, Kelei and Chen, Cheng and Zhang, Wei and Chen, Mingming and Xu, Huaye and Meng, Borong and Chen, Zongjia and Wang, Mingshuai and Wang, Luping and Zhang, Yuan and Ren, Shiru and Wang, Fang and Feng, Dan},
title = {TokaDB: A Unified Storage Engine for Training-Serving Data Management in Large Recommendation Models},
year = {2026},
isbn = {9798400724503},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3788853.3803078},
doi = {10.1145/3788853.3803078},
abstract = {Large recommendation models (LRM), powered by Transformer architectures, are rapidly becoming the backbone of modern recommendation systems. However, their training-serving lifecycle imposes unprecedented challenges on data management: hybrid access patterns for user behavior sequences, cost-performance trade-offs for exabyte-scale KV Cache data, and resource contention between prioritized workloads during training and serving. Existing approaches fail to address these challenges simultaneously, leading to performance bottlenecks or excessive costs. In this paper, we present TokaDB, a unified storage engine for LRM that efficiently manages both user behavior sequences and KV Cache data across training and serving stages. TokaDB introduces three core innovations: (1) Hybrid-Access Specialized Data Organization that segments sequence data by time and decouples indexes from data to support both high-throughput point reads and high-bandwidth range scans; (2) Cost-Efficient Cooperative I/O Engine that co-optimizes the read and write paths to reduce tail latency while sustaining high throughput; (3) Priority-Based Resource Manager that enforces priority-aware sharing of CPU, cache, and I/O resources to eliminate prioritized workload interference and ensure predictable performance. TokaDB has been deployed across production services at ByteDance and validated under real LRM workloads. Experimental results show that TokaDB achieves 4-10{\texttimes} end-to-end speedups over mainstream systems including HBase, Doris, and Doris+, satisfying all critical performance dimensions required by LRM.},
booktitle = {Companion of the International Conference on Management of Data},
pages = {293–306},
numpages = {14},
keywords = {lrm, training and serving, data management, storage engine},
location = {Bengaluru, India},
series = {SIGMOD Companion '26}
}

@inproceedings{10.1145/3625468.3647627,
author = {Rahmanian, Ali and Amin, Siddharth and Gustafsson, Harald and Ali-Eldin, Ahmed},
title = {CVF: Cross-Video Filtration on the Edge},
year = {2024},
isbn = {9798400704123},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3625468.3647627},
doi = {10.1145/3625468.3647627},
abstract = {Many edge applications rely on expensive Deep-Neural-Network (DNN) inference-based video analytics. Typically, a single instance of an inference service analyzes multiple realtime camera streams concurrently. In many cases, only a fraction of these streams contain objects-of-interest at a given time. Hence, it is a waste of computational resources to process all frames from all cameras using the DNNs. On-camera filtration of frames has been suggested as a possible solution to improve the system efficiency and reduce resource wastage. However, many cameras do not have on-camera processing or filtering capabilities. In addition, filtration can be enhanced if frames across the different feeds are selected and prioritized for processing based on the system load and the available resource capacity. This paper introduces CVF, a Cross-video Filtration framework designed around video content and resource constraints. The CVF pipeline leverages compressed-domain data from encoded video formats, lightweight binary classification models, and an efficient prioritization algorithm. This enables the effective filtering of cross-camera frames from multiple sources, processing only a fraction of frames using resource-intensive DNN models. Our experiments show that CVF is capable of reducing the overall response time of video analytics pipelines by up to 50% compared to state-of-the-art solutions while increasing the throughput by up to 120%.},
booktitle = {Proceedings of the 15th ACM Multimedia Systems Conference},
pages = {231–242},
numpages = {12},
keywords = {Codecs, Edge, Video Analytics, Video Filtration},
location = {Bari, Italy},
series = {MMSys '24}
}

