@inproceedings{10.1145/3773365.3773552,
author = {Li, Yunna and Yang, Deyun and Lu, Haipeng and Wu, Jian and Peng, Lu},
title = {Analysis of Key Technologies in Edge Computing and Practical Applications in U.S. Military Operations},
