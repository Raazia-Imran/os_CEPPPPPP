@inproceedings{10.1145/3804504.3804579,
author = {Yi, Xinyuan},
title = {Research on the development situation of logistics management under the background of artificial intelligence},
year = {2026},
isbn = {9798400722882},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3804504.3804579},
doi = {10.1145/3804504.3804579},
abstract = {With the rapid iteration of artificial intelligence technology, its integration with the field of logistics management has become the core direction of high-quality development of the industry. Based on 498 articles in CNKI database from 2016 to 2026, this paper uses CiteSpace tool to carry out visual analysis of keyword co-occurrence and clustering. The results show that the core research hotspots in the field of “Ai+logistics management” are intelligent logistics, AI technology integration and supply chain collaboration, and the research focus has shifted from “traditional logistics management” to “intelligent logistics system driven by artificial intelligence”; The development situation presents the characteristics of “Technology Collaborative empowerment, cross chain extension of fields, and research upgrading to systematic governance”, but at the same time, it faces challenges such as high cost of technology implementation, high risk of data security, and shortage of interdisciplinary talents. The research conclusion of this paper can provide reference for the theoretical research and industrial application of “Ai+logistics management”.},
booktitle = {Proceedings of the 2nd International Conference on Digital Society, Information Science and Risk Management},
pages = {479–484},
numpages = {6},
keywords = {Artificial intelligence, CiteSpace, bibliometrics, intelligent logistics, logistics management, supply chain},
location = {Shenyang, China},
series = {ICDIR '26}
}

