title = {BDNNDL '25: Proceedings of the 2025 2nd Symposium on Big Data, Neural Networks, and Deep Learning},
year = {2025},
isbn = {9798400720185},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
