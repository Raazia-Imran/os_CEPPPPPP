author = {Zheng, Haisheng and He, Zhuolun and Liu, Fangzhou and Pei, Zehua and Yu, Bei},
title = {LSTP : A Logic Synthesis Timing Predictor},
year = {2024},
isbn = {9798350393545},
publisher = {IEEE Press},
url = {https://doi.org/10.1109/ASP-DAC58780.2024.10473925},
